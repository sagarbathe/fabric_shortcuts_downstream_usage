{
  "compatibilityLevel": 1604,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DimShortcut\", \"FactShortcutInventoryDiff\", \"FactDuplicateShortcutGroup\", \"FactCopyEvent\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ],
    "tables": [
      {
        "name": "DimShortcut",
        "description": "Current-state snapshot of every OneLake shortcut discovered across the monitored workspaces. Fully replaced on every scheduled run (every 15 minutes) - a dimension of shortcuts that exist right now, not a history (see FactShortcutInventoryDiff for history). Row grain: one row per shortcut.",
        "lineageTag": "84698504-9db0-4ce9-b4ac-37fa6c104586",
        "columns": [
          {
            "name": "shortcut_sk",
            "dataType": "int64",
            "sourceColumn": "shortcut_sk",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "88a31492-44ee-4f84-a2c6-471f10941cc8",
            "description": "Deterministic surrogate key (xxhash64 of shortcut_key). The preferred join key to every Fact table in this model.",
            "isKey": true
          },
          {
            "name": "shortcut_key",
            "dataType": "string",
            "sourceColumn": "shortcut_key",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "a14d638d-8cf0-41c8-87e7-1736886cd3f9",
            "description": "Natural key: hosting_workspace_id|hosting_item_id|shortcut_path|shortcut_name. Kept for debugging only - use shortcut_sk for joins."
          },
          {
            "name": "shortcut_name",
            "dataType": "string",
            "sourceColumn": "shortcut_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "68a5fedd-4eed-4e53-86af-32dc2153e2b9",
            "description": "The shortcut display name as it appears in the hosting Lakehouse/Warehouse."
          },
          {
            "name": "hosting_workspace_id",
            "dataType": "string",
            "sourceColumn": "hosting_workspace_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "2187a451-18fb-4c6f-b44e-4b5479b4210f",
            "description": "Workspace GUID where this shortcut physically lives."
          },
          {
            "name": "hosting_workspace_name",
            "dataType": "string",
            "sourceColumn": "hosting_workspace_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "926a9a5f-d87f-4062-a940-45dfc3d2476e",
            "description": "Display name of the workspace hosting this shortcut."
          },
          {
            "name": "hosting_item_id",
            "dataType": "string",
            "sourceColumn": "hosting_item_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "5d9b6920-6952-42b5-a362-e7cdd56a670a",
            "description": "Lakehouse/Warehouse item GUID that hosts (contains) this shortcut."
          },
          {
            "name": "hosting_item_name",
            "dataType": "string",
            "sourceColumn": "hosting_item_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "7ceb16b1-f266-42f5-bb27-f92172461d72",
            "description": "Display name of the Lakehouse/Warehouse item hosting this shortcut."
          },
          {
            "name": "hosting_item_type",
            "dataType": "string",
            "sourceColumn": "hosting_item_type",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "002943b9-3826-4ca1-b825-8cffbf839927",
            "description": "Fabric item type of the hosting item, e.g. Lakehouse or Warehouse."
          },
          {
            "name": "shortcut_path",
            "dataType": "string",
            "sourceColumn": "shortcut_path",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "932cdfe2-49e3-4338-afe2-276fc356a4a2",
            "description": "Path within the hosting item where the shortcut is placed, e.g. /Tables or /Files."
          },
          {
            "name": "target_type",
            "dataType": "string",
            "sourceColumn": "target_type",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "6f18d1a8-64c6-4887-a1da-39f5f2690b06",
            "description": "Type of the shortcut target: OneLake (internal, tracked for duplicates), AmazonS3, ADLS, GCS, Dataverse (external)."
          },
          {
            "name": "source_workspace_id",
            "dataType": "string",
            "sourceColumn": "source_workspace_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "84dd7571-ba86-450a-bd60-f0182d62d517",
            "description": "For OneLake targets: workspace GUID of the shortcut source item. Blank for external targets."
          },
          {
            "name": "source_workspace_name",
            "dataType": "string",
            "sourceColumn": "source_workspace_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "86803663-a326-4fde-8e5c-7c83f317d21c",
            "description": "Display name of the source workspace (OneLake targets only)."
          },
          {
            "name": "source_item_id",
            "dataType": "string",
            "sourceColumn": "source_item_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "9b2e424e-47d0-452c-a545-32c241620cd2",
            "description": "For OneLake targets: item GUID the shortcut points to."
          },
          {
            "name": "source_item_name",
            "dataType": "string",
            "sourceColumn": "source_item_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "a7f3664f-4ee1-4edf-8821-e6947352722c",
            "description": "Display name of the source item the shortcut points to (OneLake targets only)."
          },
          {
            "name": "source_path",
            "dataType": "string",
            "sourceColumn": "source_path",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "d63a048c-7879-46f7-980e-3208cfa473ac",
            "description": "Path within the source item that the shortcut points to. Two shortcuts sharing this value (and source item) are duplicates, regardless of their own names."
          },
          {
            "name": "source_external_location",
            "dataType": "string",
            "sourceColumn": "source_external_location",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "a4b48144-57e1-4f4e-992f-bccf68abf8a3",
            "description": "For external (non-OneLake) targets: the target's storage location/endpoint (e.g. ADLS Gen2/Blob storage account URL, S3/GCS bucket URL, Dataverse environment). Blank for OneLake targets."
          },
          {
            "name": "source_external_subpath",
            "dataType": "string",
            "sourceColumn": "source_external_subpath",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "51f07baa-ac1c-4607-854f-b3244498ab7d",
            "description": "For external targets: the subpath/folder/table within the external location. Blank for OneLake targets."
          },
          {
            "name": "source_external_connection_id",
            "dataType": "string",
            "sourceColumn": "source_external_connection_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "0d9272ab-7519-4b4c-b1c0-9709423e7403",
            "description": "For external targets: GUID of the Fabric cloud connection used to reach the external source. Blank for OneLake targets."
          },
          {
            "name": "source_external_details_json",
            "dataType": "string",
            "sourceColumn": "source_external_details_json",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "a3e8fbb1-2412-40ee-b0fa-b47b5e3a9681",
            "description": "For external targets: the full raw target-type sub-object from the Fabric Shortcuts API, as JSON - every field Fabric returns for that target type. Blank for OneLake targets."
          },
          {
            "name": "is_internal_onelake",
            "dataType": "boolean",
            "sourceColumn": "is_internal_onelake",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "e1da897a-0643-4f36-8d51-c8dcf1d6e62d",
            "description": "True if target_type = OneLake, i.e. eligible for duplicate-shortcut detection; false for external targets."
          },
          {
            "name": "snapshot_ts",
            "dataType": "dateTime",
            "sourceColumn": "snapshot_ts",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "55488621-e8e2-4016-a837-7fc41a630574",
            "description": "UTC timestamp of the scan run that produced this row.",
            "formatString": "General Date"
          }
        ],
        "measures": [
          {
            "name": "Total Shortcuts",
            "expression": "COUNTROWS(DimShortcut)",
            "lineageTag": "7a2b3917-087d-4ef7-9b25-f5df7a8019a5",
            "description": "Count of all currently-existing shortcuts across monitored workspaces."
          },
          {
            "name": "Internal OneLake Shortcuts",
            "expression": "CALCULATE([Total Shortcuts], DimShortcut[is_internal_onelake] = TRUE)",
            "lineageTag": "6380c69c-2f08-441a-bb1f-73f7fc8b12d8",
            "description": "Count of currently-existing shortcuts pointing at another OneLake item (eligible for duplicate detection)."
          },
          {
            "name": "External Shortcuts",
            "expression": "[Total Shortcuts] - [Internal OneLake Shortcuts]",
            "lineageTag": "56083357-c90d-4aae-b027-777f556c30c7",
            "description": "Count of currently-existing shortcuts pointing outside OneLake (S3, ADLS, GCS, Dataverse, etc.)."
          }
        ],
        "partitions": [
          {
            "name": "DimShortcut",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "dimshortcut",
              "schemaName": "dbo",
              "expressionSource": "DirectLake - LH_ShortcutMonitoring"
            }
          }
        ]
      },
      {
        "name": "FactShortcutInventoryDiff",
        "description": "Append-only lifecycle event log of shortcut creations and deletions detected between consecutive scheduled runs (every 15 minutes). Row grain: one row per shortcut per change event (new = created since last run, removed = no longer present since last run).",
        "lineageTag": "1d5feb3a-187a-4d69-a18f-6a581405a03c",
        "columns": [
          {
            "name": "shortcut_sk",
            "dataType": "int64",
            "sourceColumn": "shortcut_sk",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "7881f92d-921c-46dd-bfd5-0df27404537c",
            "description": "Deterministic surrogate key of the shortcut this event refers to - join to DimShortcut.shortcut_sk (rows for shortcuts already removed will not match any current DimShortcut row - expected)."
          },
          {
            "name": "shortcut_key",
            "dataType": "string",
            "sourceColumn": "shortcut_key",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "bcc1430e-71ae-47d6-a568-b46b0242079c",
            "description": "Natural key of the shortcut this event refers to."
          },
          {
            "name": "change_type",
            "dataType": "string",
            "sourceColumn": "change_type",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "2e5b1ad9-4cf9-400a-b2eb-360a4e162982",
            "description": "'new' = created since the prior run. 'removed' = existed at the prior run but no longer exists now."
          },
          {
            "name": "shortcut_name",
            "dataType": "string",
            "sourceColumn": "shortcut_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "1f21aa1d-ee93-4352-be93-5634c95c84c2",
            "description": "Shortcut display name at the time of this event."
          },
          {
            "name": "hosting_workspace_id",
            "dataType": "string",
            "sourceColumn": "hosting_workspace_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "f0277afe-5ccc-4f6b-8b7b-26cff72fca44",
            "description": "Workspace GUID hosting the shortcut at the time of this event."
          },
          {
            "name": "hosting_workspace_name",
            "dataType": "string",
            "sourceColumn": "hosting_workspace_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "d251944c-417c-4d42-a9d7-a8289780bcc9",
            "description": "Display name of the hosting workspace at the time of this event."
          },
          {
            "name": "hosting_item_id",
            "dataType": "string",
            "sourceColumn": "hosting_item_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "ee7e3593-a033-4a75-871e-91256f83d0c3",
            "description": "Hosting Lakehouse/Warehouse item GUID at the time of this event."
          },
          {
            "name": "hosting_item_name",
            "dataType": "string",
            "sourceColumn": "hosting_item_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "53179b1b-8b7a-4edd-b223-7e61de622a9d",
            "description": "Display name of the hosting item at the time of this event."
          },
          {
            "name": "hosting_item_type",
            "dataType": "string",
            "sourceColumn": "hosting_item_type",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "edd42375-95cd-4d15-9d0c-4bd983021e3c",
            "description": "Fabric item type of the hosting item."
          },
          {
            "name": "shortcut_path",
            "dataType": "string",
            "sourceColumn": "shortcut_path",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "8985ffab-b56a-492d-871f-f697ce862d45",
            "description": "Path within the hosting item, e.g. /Tables or /Files."
          },
          {
            "name": "target_type",
            "dataType": "string",
            "sourceColumn": "target_type",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "4c4f9699-ac78-406e-8312-a7244773f346",
            "description": "Type of the shortcut target (OneLake, AmazonS3, ADLS, GCS, Dataverse, etc.)."
          },
          {
            "name": "source_workspace_id",
            "dataType": "string",
            "sourceColumn": "source_workspace_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "da5ebe62-6fb9-42af-b8b2-e5302a049c4d",
            "description": "For OneLake targets: source item workspace GUID."
          },
          {
            "name": "source_workspace_name",
            "dataType": "string",
            "sourceColumn": "source_workspace_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "b25dcf26-4519-4636-8884-5c51f63e8ef9",
            "description": "Display name of the source workspace (OneLake targets only)."
          },
          {
            "name": "source_item_id",
            "dataType": "string",
            "sourceColumn": "source_item_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "277cfb03-63d5-4a48-a6ad-5657e2a4fa18",
            "description": "For OneLake targets: source item GUID."
          },
          {
            "name": "source_item_name",
            "dataType": "string",
            "sourceColumn": "source_item_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "1b7c0e3e-9fab-4fb1-a214-4a4837a55050",
            "description": "Display name of the source item (OneLake targets only)."
          },
          {
            "name": "source_path",
            "dataType": "string",
            "sourceColumn": "source_path",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "c3d1bdfc-6044-4785-92c7-01c2ed694fec",
            "description": "Path within the source item that the shortcut points to."
          },
          {
            "name": "source_external_location",
            "dataType": "string",
            "sourceColumn": "source_external_location",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "b4cb78ec-51f4-4aa1-995b-b4ffd9bda78d",
            "description": "For external targets: the target's storage location/endpoint at the time of this event. Blank for OneLake targets."
          },
          {
            "name": "source_external_subpath",
            "dataType": "string",
            "sourceColumn": "source_external_subpath",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "79afd4e8-4f5a-44c1-bcaa-f7897860da9e",
            "description": "For external targets: the subpath/folder/table within the external location at the time of this event. Blank for OneLake targets."
          },
          {
            "name": "source_external_connection_id",
            "dataType": "string",
            "sourceColumn": "source_external_connection_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "c60d780b-870c-476f-a3aa-9141a87772c2",
            "description": "For external targets: GUID of the Fabric cloud connection used to reach the external source at the time of this event. Blank for OneLake targets."
          },
          {
            "name": "source_external_details_json",
            "dataType": "string",
            "sourceColumn": "source_external_details_json",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "9bcb7aa3-a4ea-4432-82c1-a8e9e1c98c03",
            "description": "For external targets: the full raw target-type sub-object from the Fabric Shortcuts API at the time of this event, as JSON. Blank for OneLake targets."
          },
          {
            "name": "is_internal_onelake",
            "dataType": "boolean",
            "sourceColumn": "is_internal_onelake",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "b5ee7826-ccdc-4b78-9d2d-0856171c97e4",
            "description": "True if this was an internal OneLake shortcut (duplicate-detection eligible)."
          },
          {
            "name": "snapshot_ts",
            "dataType": "dateTime",
            "sourceColumn": "snapshot_ts",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "76c828eb-21c1-472a-9b13-96f734a9e393",
            "description": "UTC timestamp of the scan run in which this change was detected.",
            "formatString": "General Date"
          }
        ],
        "measures": [
          {
            "name": "Shortcuts Added",
            "expression": "CALCULATE(COUNTROWS(FactShortcutInventoryDiff), FactShortcutInventoryDiff[change_type] = \"new\")",
            "lineageTag": "f681b1b0-5eba-4e66-b875-eb353a7fba76",
            "description": "Count of shortcut-creation events in the current filter context."
          },
          {
            "name": "Shortcuts Removed",
            "expression": "CALCULATE(COUNTROWS(FactShortcutInventoryDiff), FactShortcutInventoryDiff[change_type] = \"removed\")",
            "lineageTag": "e9ed6b04-0505-461e-be5e-a83f8699dfc5",
            "description": "Count of shortcut-deletion events in the current filter context."
          },
          {
            "name": "Net Shortcut Change",
            "expression": "[Shortcuts Added] - [Shortcuts Removed]",
            "lineageTag": "5556eb6a-a895-4896-bdff-5296857bd999",
            "description": "Net change in shortcut count in the current filter context (positive = growing, negative = shrinking)."
          }
        ],
        "partitions": [
          {
            "name": "FactShortcutInventoryDiff",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "factshortcutinventorydiff",
              "schemaName": "dbo",
              "expressionSource": "DirectLake - LH_ShortcutMonitoring"
            }
          }
        ]
      },
      {
        "name": "FactDuplicateShortcutGroup",
        "description": "One row per shortcut that is a member of a duplicate-shortcut group, i.e. two or more shortcuts point at the exact same source item/path. High severity = duplicates live in the SAME hosting item (pure redundancy). Medium severity = duplicates live in the SAME hosting workspace but DIFFERENT hosting items. The same source shortcut reused in a DIFFERENT workspace is normal reuse and is never flagged here. Not consumed by either copy-event engine - a control-plane governance signal only.",
        "lineageTag": "c65cec6a-835b-42dc-bafe-d3682d77c139",
        "columns": [
          {
            "name": "duplicate_group_id",
            "dataType": "string",
            "sourceColumn": "duplicate_group_id",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "edd83db2-a95e-43bb-afda-a176b7916d65",
            "description": "Stable hash identifying one duplicate group. Group all rows sharing this id to see the full duplicate set."
          },
          {
            "name": "shortcut_sk",
            "dataType": "int64",
            "sourceColumn": "shortcut_sk",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "6e708b67-d896-4570-a82d-8c3c44f37571",
            "description": "Deterministic surrogate key of the duplicated shortcut - join to DimShortcut.shortcut_sk."
          },
          {
            "name": "shortcut_key",
            "dataType": "string",
            "sourceColumn": "shortcut_key",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "19286e3b-7cbf-4ece-bee7-8e408dc71819",
            "description": "Natural key of the duplicated shortcut."
          },
          {
            "name": "shortcut_name",
            "dataType": "string",
            "sourceColumn": "shortcut_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "071842a5-5802-4d33-88d0-fbdc8836d58b",
            "description": "Display name of this specific duplicate shortcut."
          },
          {
            "name": "hosting_workspace_id",
            "dataType": "string",
            "sourceColumn": "hosting_workspace_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "af16e901-6901-4420-a0cf-ea81050022f2",
            "description": "Workspace GUID hosting this specific duplicate shortcut."
          },
          {
            "name": "hosting_workspace_name",
            "dataType": "string",
            "sourceColumn": "hosting_workspace_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "b1596eb5-d76d-484c-9c93-cd423a6382d2",
            "description": "Display name of the workspace hosting this specific duplicate shortcut."
          },
          {
            "name": "hosting_item_id",
            "dataType": "string",
            "sourceColumn": "hosting_item_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "8c241cf1-cee6-40e5-bb87-faae07ee3e6e",
            "description": "Lakehouse/Warehouse item GUID hosting this specific duplicate shortcut."
          },
          {
            "name": "hosting_item_name",
            "dataType": "string",
            "sourceColumn": "hosting_item_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "311ad2a7-8c6f-4c97-b8ea-f86388eee682",
            "description": "Display name of the item hosting this specific duplicate shortcut."
          },
          {
            "name": "source_workspace_id",
            "dataType": "string",
            "sourceColumn": "source_workspace_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "221cda31-78c1-46e4-a33c-6b3f70ba04c6",
            "description": "Workspace GUID of the common source all group members point to."
          },
          {
            "name": "source_workspace_name",
            "dataType": "string",
            "sourceColumn": "source_workspace_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "7b6e9113-79a8-4eef-b034-8f0c76107bbe",
            "description": "Display name of the common source workspace."
          },
          {
            "name": "source_item_id",
            "dataType": "string",
            "sourceColumn": "source_item_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "f0a096a1-146c-4c70-b015-a63302cde3e7",
            "description": "Item GUID of the common source all group members point to."
          },
          {
            "name": "source_item_name",
            "dataType": "string",
            "sourceColumn": "source_item_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "8c01a473-8a4f-4016-9c1e-1544f4994c6b",
            "description": "Display name of the common source item."
          },
          {
            "name": "source_path",
            "dataType": "string",
            "sourceColumn": "source_path",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "9e3b50e2-090f-448b-812f-f086632f2e79",
            "description": "Common source path all group members point to - this is the field that makes them duplicates."
          },
          {
            "name": "group_member_count",
            "dataType": "string",
            "sourceColumn": "group_member_count",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "ace531b8-e821-4ca7-8b45-2054d5cbbdd6",
            "description": "Total number of shortcuts in this duplicate group, as text (raw Delta type). Use the 'Group Member Count' measure for numeric aggregation."
          },
          {
            "name": "severity",
            "dataType": "string",
            "sourceColumn": "severity",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "43c82248-b124-4b61-8e54-e0f3045fa238",
            "description": "High = duplicates share the same hosting item. Medium = duplicates share the hosting workspace but live in different hosting items."
          },
          {
            "name": "explanation",
            "dataType": "string",
            "sourceColumn": "explanation",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "24bdcc2a-1ad6-4bac-8fa5-12dd3bc0e0b4",
            "description": "Human-readable reason for the assigned severity."
          },
          {
            "name": "detected_ts",
            "dataType": "string",
            "sourceColumn": "detected_ts",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "0a88da06-8ecd-4a8d-8285-d38d4dfe003d",
            "description": "UTC timestamp when this duplicate group was last (re)computed, as text (raw Delta type). Use the 'Detected At' measure for a proper datetime."
          }
        ],
        "measures": [
          {
            "name": "Duplicate Groups",
            "expression": "DISTINCTCOUNT(FactDuplicateShortcutGroup[duplicate_group_id])",
            "lineageTag": "e99cee62-2997-4176-b4a5-891ee308461b",
            "description": "Count of distinct duplicate-shortcut groups in the current filter context."
          },
          {
            "name": "High Severity Groups",
            "expression": "CALCULATE([Duplicate Groups], FactDuplicateShortcutGroup[severity] = \"High\")",
            "lineageTag": "9ea7489b-0697-4c5c-b1fe-cf29093f5b28",
            "description": "Count of distinct High-severity duplicate groups (duplicates in the same hosting item)."
          },
          {
            "name": "Medium Severity Groups",
            "expression": "CALCULATE([Duplicate Groups], FactDuplicateShortcutGroup[severity] = \"Medium\")",
            "lineageTag": "a329559b-0b10-4a29-8cef-4690077c9ce2",
            "description": "Count of distinct Medium-severity duplicate groups (duplicates in the same workspace, different hosting items)."
          },
          {
            "name": "Duplicate Shortcuts (rows)",
            "expression": "COUNTROWS(FactDuplicateShortcutGroup)",
            "lineageTag": "fe169622-0db6-4e6f-813f-f1629973767a",
            "description": "Total count of individual shortcuts that are members of any duplicate group (not deduplicated by group)."
          },
          {
            "name": "Group Member Count",
            "expression": "AVERAGEX(FactDuplicateShortcutGroup, VALUE(FactDuplicateShortcutGroup[group_member_count]))",
            "lineageTag": "b03e8f4f-84c0-4bfe-9a75-83e49a5ed02f",
            "description": "Numeric version of group_member_count, for aggregation/sorting in visuals. A measure (not a calculated column) because Direct Lake models in this solution use measures only."
          },
          {
            "name": "Duplicate Group Detected At",
            "expression": "MAXX(FactDuplicateShortcutGroup, VAR t = SUBSTITUTE(LEFT(FactDuplicateShortcutGroup[detected_ts], 19), \"T\", \" \") RETURN DATEVALUE(t) + TIMEVALUE(t))",
            "lineageTag": "dd020bb8-68c6-4b32-bd47-e8cf20862643",
            "description": "detected_ts parsed into a proper datetime, for use in date slicers/axes.",
            "formatString": "General Date"
          }
        ],
        "partitions": [
          {
            "name": "FactDuplicateShortcutGroup",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "factduplicateshortcutgroup",
              "schemaName": "dbo",
              "expressionSource": "DirectLake - LH_ShortcutMonitoring"
            }
          }
        ]
      },
      {
        "name": "FactCopyEvent",
        "description": "One row per detected read-from-shortcut copy event, across the implemented engines: Warehouse (CTAS/INSERT-SELECT via Query Insights) and SparkKafka (OpenLineage column-lineage detection via the ES_OpenLineageEvents Eventstream), distinguished by the engine column. is_shortcut_read_and_saved_as_is = TRUE when the write retained ALL source columns (SELECT * equivalent) OR retention_pct > threshold_pct_at_detection, even if extra new columns were also added - this is the core signal the whole solution exists to raise. This table does NOT physically include vw_FactCopyEvent_SourceStatus's two enrichment columns - they are reproduced here as the 'Source Shortcut Exists Now' and 'Source Removed At' measures instead, to avoid importing a second overlapping copy of this same grain.",
        "lineageTag": "5a40921d-5613-41b3-ad60-2ceff3f278ca",
        "columns": [
          {
            "name": "event_id",
            "dataType": "string",
            "sourceColumn": "event_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "62a2a3da-544f-4a91-b541-fc86d7f6a769",
            "description": "Natural key. Warehouse: {item_id}|{distributed_statement_id}. SparkKafka: an OpenLineage-run-derived identifier. Unique per engine."
          },
          {
            "name": "hosting_workspace_id",
            "dataType": "string",
            "sourceColumn": "hosting_workspace_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "05c890d1-a291-46e7-8489-f8efa84b6bf0",
            "description": "Workspace GUID where the copy statement/notebook ran."
          },
          {
            "name": "hosting_workspace_name",
            "dataType": "string",
            "sourceColumn": "hosting_workspace_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "9c4d0fc0-b35f-45ed-b36f-9cac8a3c2fdb",
            "description": "Display name of the workspace where the copy ran."
          },
          {
            "name": "hosting_item_id",
            "dataType": "string",
            "sourceColumn": "hosting_item_id",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "aacea92b-03d2-43be-8f21-97527e060d20",
            "description": "Warehouse item GUID (Warehouse engine) or notebook item GUID (SparkKafka engine) where the copy ran."
          },
          {
            "name": "hosting_item_name",
            "dataType": "string",
            "sourceColumn": "hosting_item_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "f38989bf-2957-47d3-bff3-c9e426086958",
            "description": "Warehouse: the Warehouse item name. SparkKafka: the monitored notebook's name."
          },
          {
            "name": "engine",
            "dataType": "string",
            "sourceColumn": "engine",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "12663a58-6ea3-4322-b28d-58820a0645db",
            "description": "Fabric engine that executed the copy: Warehouse or SparkKafka. (Dataflow Gen2 is designed but not implemented - see design doc.)"
          },
          {
            "name": "matched_shortcut_name",
            "dataType": "string",
            "sourceColumn": "matched_shortcut_name",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "eb820d15-8ba0-439b-8aa9-112d6857be27",
            "description": "Name of the OneLake shortcut the statement/notebook read from (matched against DimShortcut)."
          },
          {
            "name": "matched_shortcut_database",
            "dataType": "string",
            "sourceColumn": "matched_shortcut_database",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "de0fab7e-55b1-4fe4-b3ad-ee23a872ab33",
            "description": "Name of the hosting Lakehouse/Warehouse item where the matched shortcut lives (may differ from hosting_item_name for cross-item copies)."
          },
          {
            "name": "shortcut_sk",
            "dataType": "int64",
            "sourceColumn": "shortcut_sk",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "b80901ab-86d5-4180-95bf-ccf5e0442775",
            "description": "Deterministic surrogate key of the matched shortcut, looked up from DimShortcut.shortcut_sk by the copy-event notebooks at detection time and stored as a real Delta column - the join key to DimShortcut (Direct Lake relationships cannot use a calculated column as a key). Blank if the matched shortcut could not be resolved at detection time."
          },
          {
            "name": "dest_table",
            "dataType": "string",
            "sourceColumn": "dest_table",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "15b18126-d7d8-49e5-84b8-a407cdef23a3",
            "description": "Destination table name the SELECT/write was saved into."
          },
          {
            "name": "source_column_count",
            "dataType": "int64",
            "sourceColumn": "source_column_count",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "c8215689-c326-4614-aa64-76302fff04e3",
            "description": "Total column count of the shortcut source table."
          },
          {
            "name": "dest_column_count",
            "dataType": "int64",
            "sourceColumn": "dest_column_count",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "3a3fd44a-9333-429d-9a5a-481236b05b38",
            "description": "Column count actually written to the destination table."
          },
          {
            "name": "retained_column_count",
            "dataType": "int64",
            "sourceColumn": "retained_column_count",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "8eac907c-6a9e-451b-ad8d-9cbc5cf25822",
            "description": "Number of destination columns considered retained from the source (capped at source_column_count)."
          },
          {
            "name": "retention_pct",
            "dataType": "double",
            "sourceColumn": "retention_pct",
            "summarizeBy": "average",
            "isHidden": false,
            "lineageTag": "841c6801-fb0a-4669-84b3-e69ec65f4b56",
            "description": "retained_column_count / source_column_count * 100.",
            "formatString": "0.0\"%\""
          },
          {
            "name": "is_select_star",
            "dataType": "boolean",
            "sourceColumn": "is_select_star",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "ecfee7ce-5a8d-44aa-b6a2-e52cc12382c4",
            "description": "TRUE if the statement used SELECT * (Warehouse) / retained all columns (SparkKafka)."
          },
          {
            "name": "is_shortcut_read_and_saved_as_is",
            "dataType": "boolean",
            "sourceColumn": "is_shortcut_read_and_saved_as_is",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "c2e0ab57-2ad5-410b-ba6c-0a8770466802",
            "description": "TRUE if is_select_star OR retention_pct > threshold_pct_at_detection - the flag this whole solution exists to raise."
          },
          {
            "name": "threshold_pct_at_detection",
            "dataType": "double",
            "sourceColumn": "threshold_pct_at_detection",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "9020a0b2-7753-4416-b7b3-b04e1a418f33",
            "description": "Configurable retention threshold (config.detection.columnRetentionThresholdPercent) in effect when this row was computed.",
            "formatString": "0.0\"%\""
          },
          {
            "name": "copy_event_starttime",
            "dataType": "string",
            "sourceColumn": "copy_event_starttime",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "9eea783a-d81c-43c8-b369-77fa7a7ba781",
            "description": "Start time of the source query/write, as text (raw Delta type, kept as STRING to avoid a Delta schema-merge conflict). Use the 'Query Start At' measure for a proper datetime."
          },
          {
            "name": "copy_event_detected_time",
            "dataType": "string",
            "sourceColumn": "copy_event_detected_time",
            "summarizeBy": "none",
            "isHidden": true,
            "lineageTag": "4b4e8f0f-0a1a-4133-9df9-964b38cd9dbe",
            "description": "UTC timestamp this row was detected/computed, as text (raw Delta type). Use the 'Detected At' measure for a proper datetime."
          },
          {
            "name": "username",
            "dataType": "string",
            "sourceColumn": "username",
            "summarizeBy": "none",
            "isHidden": false,
            "lineageTag": "5a32f8c8-bf2f-4e4d-8810-62be7fc5c39c",
            "description": "Identity that executed the copy. Warehouse: login_name from Query Insights. SparkKafka: resolved via Fabric Workspace Monitoring's ItemJobEventLogs (ExecutingPrincipalId, joined on the exact JobInstanceId embedded in the OpenLineage job.name) and Microsoft Graph. Blank if the identity could not be resolved (falls back to the raw AAD object id)."
          }
        ],
        "measures": [
          {
            "name": "Total Copy Events",
            "expression": "COUNTROWS(FactCopyEvent)",
            "lineageTag": "3d6fbe8a-d597-42a3-8356-449a21c24d55",
            "description": "Count of all detected copy events (both engines) in the current filter context."
          },
          {
            "name": "Flagged Copy Events",
            "expression": "CALCULATE([Total Copy Events], FactCopyEvent[is_shortcut_read_and_saved_as_is] = TRUE)",
            "lineageTag": "a0f3f694-628b-40cc-9fa0-295409c6b109",
            "description": "Count of copy events flagged as 'shortcut read and saved as-is' - the core risk signal."
          },
          {
            "name": "Flagged %",
            "expression": "DIVIDE([Flagged Copy Events], [Total Copy Events])",
            "lineageTag": "1e3f3593-357d-4864-90a0-ad460d1b4a75",
            "description": "Share of copy events flagged as read-and-saved-as-is.",
            "formatString": "0.0%"
          },
          {
            "name": "Avg Retention %",
            "expression": "AVERAGE(FactCopyEvent[retention_pct])",
            "lineageTag": "13a92edd-7e8f-47ff-a7df-aca553ee6666",
            "description": "Average column-retention percentage across copy events in the current filter context.",
            "formatString": "0.0\"%\""
          },
          {
            "name": "Copy Events - Warehouse",
            "expression": "CALCULATE([Total Copy Events], FactCopyEvent[engine] = \"Warehouse\")",
            "lineageTag": "b7b14d48-4fd4-40ec-94e5-befa024fe748",
            "description": "Count of copy events detected by the Warehouse engine."
          },
          {
            "name": "Copy Events - Spark",
            "expression": "CALCULATE([Total Copy Events], FactCopyEvent[engine] = \"SparkKafka\")",
            "lineageTag": "a9f32786-f699-4802-b230-4508a38c9702",
            "description": "Count of copy events detected by the Spark/OpenLineage engine."
          },
          {
            "name": "Source Shortcut Exists Now",
            "expression": "VAR ws = SELECTEDVALUE(FactCopyEvent[hosting_workspace_id])\nVAR db = SELECTEDVALUE(FactCopyEvent[matched_shortcut_database])\nVAR sn = SELECTEDVALUE(FactCopyEvent[matched_shortcut_name])\nRETURN\n\tNOT ISEMPTY(\n\t\tFILTER(\n\t\t\tALL(DimShortcut),\n\t\t\tDimShortcut[hosting_workspace_id] = ws && DimShortcut[hosting_item_name] = db && DimShortcut[shortcut_name] = sn\n\t\t)\n\t)",
            "lineageTag": "4a6a2dc6-3200-468d-813e-ca88e114e3ae",
            "description": "TRUE if the shortcut this copy event read from still exists in the current DimShortcut snapshot. Reproduces vw_FactCopyEvent_SourceStatus.source_shortcut_exists_now at the semantic-model layer. A measure (not a calculated column) - evaluate it per-row in a table/matrix visual filtered to one FactCopyEvent row."
          },
          {
            "name": "Source Removed At",
            "expression": "VAR ws = SELECTEDVALUE(FactCopyEvent[hosting_workspace_id])\nVAR db = SELECTEDVALUE(FactCopyEvent[matched_shortcut_database])\nVAR sn = SELECTEDVALUE(FactCopyEvent[matched_shortcut_name])\nRETURN\n\tCALCULATE(\n\t\tMAX(FactShortcutInventoryDiff[snapshot_ts]),\n\t\tALL(FactShortcutInventoryDiff),\n\t\tFactShortcutInventoryDiff[hosting_workspace_id] = ws,\n\t\tFactShortcutInventoryDiff[hosting_item_name] = db,\n\t\tFactShortcutInventoryDiff[shortcut_name] = sn,\n\t\tFactShortcutInventoryDiff[change_type] = \"removed\"\n\t)",
            "lineageTag": "5a2f0937-80f3-4ef9-8349-1df478b92931",
            "description": "If the source shortcut no longer exists, the most recent time its removal was detected. Reproduces vw_FactCopyEvent_SourceStatus.source_removed_ts at the semantic-model layer. Blank if the shortcut still exists or was never seen being removed.",
            "formatString": "General Date"
          },
          {
            "name": "Copy Event Detected At",
            "expression": "MAXX(FactCopyEvent, VAR t = SUBSTITUTE(LEFT(FactCopyEvent[copy_event_detected_time], 19), \"T\", \" \") RETURN DATEVALUE(t) + TIMEVALUE(t))",
            "lineageTag": "1fcebdb5-cb58-4c15-9b66-a5aa914cbe12",
            "description": "copy_event_detected_time parsed into a proper datetime, for use in date slicers/axes/trend visuals.",
            "formatString": "General Date"
          },
          {
            "name": "Query Start At",
            "expression": "MAXX(FactCopyEvent, VAR t = SUBSTITUTE(LEFT(FactCopyEvent[copy_event_starttime], 19), \"T\", \" \") RETURN DATEVALUE(t) + TIMEVALUE(t))",
            "lineageTag": "df034066-9ac5-4ef7-b6f3-0ac302522235",
            "description": "copy_event_starttime parsed into a proper datetime, for use in date slicers/axes/trend visuals.",
            "formatString": "General Date"
          },
          {
            "name": "Copy Events - Orphaned Source",
            "expression": "CALCULATE([Total Copy Events], FILTER(FactCopyEvent, [Source Shortcut Exists Now] = FALSE()))",
            "lineageTag": "a43ab170-21b2-4ad8-b890-e0444aa6f4a7",
            "description": "Count of copy events whose source shortcut has since been deleted."
          },
          {
            "name": "Distinct Users",
            "expression": "DISTINCTCOUNT(FactCopyEvent[username])",
            "lineageTag": "73013bdb-a0d9-43d3-a7a1-9de7717314ee",
            "description": "Count of distinct identities that have executed a copy event, in the current filter context. Excludes blank username (rows written before the column existed, or unresolved identities)."
          },
          {
            "name": "Copy Events - Unknown User",
            "expression": "CALCULATE([Total Copy Events], FactCopyEvent[username] = BLANK())",
            "lineageTag": "64ed14a2-c1b6-4996-b707-62ec70092257",
            "description": "Count of copy events with no resolved username - either written before the username column existed, or the identity could not be resolved at detection time."
          }
        ],
        "partitions": [
          {
            "name": "FactCopyEvent",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "factcopyevent",
              "schemaName": "dbo",
              "expressionSource": "DirectLake - LH_ShortcutMonitoring"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "7115560a-cf69-41e5-8692-5a944fec37ed",
        "fromTable": "FactCopyEvent",
        "fromColumn": "shortcut_sk",
        "toTable": "DimShortcut",
        "toColumn": "shortcut_sk",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "0ec28003-b1de-4d07-830f-da6d9f6b67bb",
        "fromTable": "FactDuplicateShortcutGroup",
        "fromColumn": "shortcut_sk",
        "toTable": "DimShortcut",
        "toColumn": "shortcut_sk",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "07da75c6-cfc3-4eb0-9b31-71ada35d2911",
